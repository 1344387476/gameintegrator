.history-detail {
  --page-bg: #f2f2f7;
  --surface: #ffffff;
  --surface-secondary: #f2f2f7;
  --glass: rgba(250,250,252,.94);
  --text-primary: #1c1c1e;
  --text-secondary: #636366;
  --text-tertiary: #8e8e93;
  --separator: rgba(60,60,67,.12);
  --accent: #248d52;
  --accent-soft: rgba(36,141,82,.1);
  --positive: #248d52;
  --negative: #d64545;
}
.history-detail.theme-dark {
  --page-bg: #111412;
  --surface: #202421;
  --surface-secondary: #292e2a;
  --glass: rgba(30,34,31,.96);
  --text-primary: #f2f4f2;
  --text-secondary: #c3c7c4;
  --text-tertiary: #8e9690;
  --separator: rgba(235,242,237,.1);
  --accent: #45bd78;
  --accent-soft: rgba(69,189,120,.14);
  --positive: #61ce8d;
  --negative: #ef817b;
}
.detail-mask { position: fixed; inset: 0; z-index: 109; background: rgba(10,12,11,.3); backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx); animation: mask-in 180ms ease-out both; }
.theme-dark .detail-mask { background: rgba(0,0,0,.48); }
.detail-sheet { position: fixed; right: 0; bottom: 0; left: 0; z-index: 110; display: flex; max-height: 88vh; flex-direction: column; overflow: hidden; border: 1rpx solid var(--separator); border-bottom: 0; border-radius: 36rpx 36rpx 0 0; background: var(--glass); box-shadow: 0 -18rpx 54rpx rgba(0,0,0,.12); backdrop-filter: blur(30rpx); -webkit-backdrop-filter: blur(30rpx); animation: sheet-in 320ms cubic-bezier(.22,1,.36,1) both; }
.sheet-handle { width: 72rpx; height: 8rpx; margin: 14rpx auto 8rpx; border-radius: 99rpx; background: var(--separator); }
.detail-header { display: flex; min-height: 88rpx; align-items: center; justify-content: space-between; padding: 18rpx 22rpx 20rpx 30rpx; border-bottom: 1rpx solid var(--separator); }
.detail-heading { min-width: 0; }
.detail-title { display: block; overflow: hidden; color: var(--text-primary); font-size: 34rpx; font-weight: 750; text-overflow: ellipsis; white-space: nowrap; }
.detail-meta { display: block; margin-top: 7rpx; color: var(--text-tertiary); font-size: 21rpx; }
.detail-close { display: flex; width: 52rpx; height: 52rpx; flex-shrink: 0; align-items: center; justify-content: center; margin-left: 20rpx; border-radius: 50%; background: var(--surface-secondary); color: var(--text-tertiary); font-size: 23rpx; }
.detail-state { display: flex; min-height: 360rpx; flex-direction: column; align-items: center; justify-content: center; gap: 18rpx; color: var(--text-secondary); font-size: 24rpx; }
.loading-spinner { width: 38rpx; height: 38rpx; box-sizing: border-box; border: 4rpx solid var(--separator); border-top-color: var(--accent); border-radius: 50%; animation: spinner 720ms linear infinite; }
.detail-scroll { flex: 1; min-height: 300rpx; padding: 20rpx 28rpx 0; box-sizing: border-box; }
.result-overview { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; padding: 24rpx 26rpx; border-radius: 26rpx; background: var(--accent-soft); }
.overview-label { display: block; color: var(--text-tertiary); font-size: 21rpx; }
.overview-result { display: block; margin-top: 6rpx; color: var(--text-primary); font-size: 28rpx; font-weight: 700; }
.overview-score { font-size: 38rpx; font-weight: 750; }.overview-score.positive { color: var(--positive); }.overview-score.negative { color: var(--negative); }.overview-score.zero { color: var(--text-tertiary); }
.settlement-card { margin-bottom: 20rpx; padding: 24rpx; border-radius: 26rpx; background: rgba(127,127,127,.065); }
.settlement-header { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.settlement-header .section-label { margin-bottom: 14rpx; }
.settlement-hint { color: var(--text-tertiary); font-size: 19rpx; white-space: nowrap; }
.settlement-empty,.settlement-warning { padding: 22rpx 10rpx; border-radius: 16rpx; color: var(--text-tertiary); font-size: 22rpx; text-align: center; }
.settlement-warning { background: rgba(214,69,69,.1); color: var(--negative); }
.settlement-list { display: flex; flex-direction: column; gap: 12rpx; }
.settlement-flow { display: flex; min-width: 0; align-items: stretch; padding: 13rpx; border-radius: 18rpx; background: var(--surface); }
.settlement-person { display: flex; width: 82rpx; min-width: 0; flex-shrink: 0; flex-direction: column; align-items: center; gap: 5rpx; }
.settlement-avatar { width: 48rpx; height: 48rpx; border: 1rpx solid var(--separator); border-radius: 50%; background: var(--surface-secondary); }
.settlement-name { display: block; width: 100%; overflow: hidden; color: var(--text-secondary); font-size: 20rpx; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
.settlement-person.payer .settlement-name { color: var(--negative); font-weight: 650; }
.settlement-person.receiver .settlement-name { color: var(--positive); font-weight: 650; }
.settlement-targets { display: flex; min-width: 0; flex: 1; flex-wrap: wrap; align-items: center; row-gap: 12rpx; }
.settlement-target { display: flex; min-width: 142rpx; flex: 1 1 46%; align-items: center; }
.settlement-arrow { display: flex; min-width: 58rpx; flex: 1; flex-direction: column; align-items: center; justify-content: center; color: var(--accent); font-size: 28rpx; font-weight: 700; line-height: 1; }
.settlement-amount { color: var(--text-primary); font-size: 21rpx; font-weight: 750; }
.ranking-card { margin-bottom: 20rpx; padding: 26rpx; border-radius: 26rpx; background: rgba(127,127,127,.065); }
.section-label { display: block; margin-bottom: 16rpx; color: var(--text-secondary); font-size: 23rpx; font-weight: 650; }
.empty-ranking { padding: 40rpx 0; text-align: center; color: var(--text-tertiary); font-size: 23rpx; }
.player-row { display: flex; height: 92rpx; align-items: center; border-top: 1rpx solid var(--separator); }
.player-row.is-me { margin: 0 -12rpx; padding: 0 12rpx; border-radius: 18rpx; background: var(--accent-soft); }
.rank-number { width: 46rpx; color: var(--text-tertiary); font-size: 23rpx; }
.player-avatar { width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 50%; background: var(--surface-secondary); }
.player-name { flex: 1; margin-left: 16rpx; overflow: hidden; color: var(--text-primary); font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.player-score { font-size: 28rpx; font-weight: 750; }.player-score.positive { color: var(--positive); }.player-score.negative { color: var(--negative); }.player-score.zero { color: var(--text-tertiary); }
.detail-spacer { height: 24rpx; }
.detail-actions { display: flex; gap: 16rpx; padding: 18rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid var(--separator); background: var(--glass); }
.detail-button { display: flex; flex: 1; height: 88rpx; align-items: center; justify-content: center; margin: 0; border: 0; border-radius: 22rpx; font-size: 27rpx; font-weight: 650; line-height: 1; }
.detail-button::after { border: 0; }.detail-button.secondary { background: var(--surface-secondary); color: var(--text-primary); }.detail-button.primary { background: var(--accent); color: #fff; }.detail-button.disabled { opacity: .62; }
.button-pressed { opacity: .72; transform: scale(.98); }
.history-poster { position: fixed; top: -2000px; left: -2000px; width: 750px; height: 1200px; }
.detail-heading { flex: 1; min-width: 0; }
.detail-meta { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-row { min-width: 0; }
.player-avatar,.rank-number { flex-shrink: 0; }
.player-score { max-width: 38%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.player-score.compact-number { font-size: 19rpx; letter-spacing: -1rpx; }
.settlement-flow,.settlement-targets,.settlement-target { min-width: 0; }
.settlement-amount { display: block; max-width: 100%; overflow: hidden; font-size: 18rpx; letter-spacing: -1rpx; text-overflow: ellipsis; white-space: nowrap; }
.overview-score { max-width: 48%; overflow: hidden; font-size: 32rpx; text-overflow: ellipsis; white-space: nowrap; }
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-in { from { opacity: .55; transform: translate3d(0,100%,0); } to { opacity: 1; transform: translate3d(0,0,0); } }
@keyframes spinner { to { transform: rotate(360deg); } }
