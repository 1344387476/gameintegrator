<view class="record-page theme-{{appearanceTheme}}">
  <view class="record-intro">
    <text class="record-kicker">GAME HISTORY</text>
    <text class="record-title">每一局，都有迹可循</text>
    <text class="record-subtitle">仅展示新版结算后你参与的牌局</text>
  </view>

  <view class="state-card" wx:if="{{loading}}"><view class="weui-loading"></view><text>正在加载战绩</text></view>
  <view class="state-card error" wx:elif="{{errorText && items.length === 0}}" bindtap="retryLoad"><text>{{errorText}}</text><text class="retry">点击重试</text></view>
  <view class="state-card empty" wx:elif="{{!loading && items.length === 0}}"><text class="empty-icon">◎</text><text class="empty-title">还没有战绩</text><text class="empty-subtitle">完成并结算一局后，记录会出现在这里</text></view>

  <view class="history-list" wx:else>
    <view class="history-card" wx:for="{{items}}" wx:key="historyId" data-id="{{item.historyId}}" bindtap="openDetail" hover-class="history-card--pressed">
      <view class="history-card__top"><text class="history-card__name">{{item.roomName}}</text><text class="result-pill {{item.resultClass}}">{{item.resultText}}</text></view>
      <view class="history-card__meta"><text>{{item.displayTime}}</text><text>·</text><text>{{item.modeText}}</text><text>·</text><text>{{item.participantCount}} 人</text></view>
      <view class="history-card__bottom"><text class="history-card__label">我的积分</text><text class="history-score {{item.resultClass}}">{{item.displayScore}}</text><text class="history-arrow">›</text></view>
    </view>
    <view class="load-more" wx:if="{{loadingMore}}"><view class="weui-loading"></view><text>加载更多</text></view>
    <view class="load-more" wx:elif="{{!hasMore}}">已显示全部战绩</view>
    <view class="load-more retry" wx:elif="{{errorText}}" bindtap="retryLoad">加载失败，点击重试</view>
  </view>

  <view class="detail-mask {{showDetail ? 'show' : ''}}" wx:if="{{showDetail}}" bindtap="closeDetail"></view>
  <view class="detail-sheet {{showDetail ? 'show' : ''}}" wx:if="{{showDetail}}">
    <view class="sheet-handle"></view>
    <view class="detail-header"><view><text class="detail-title">{{detail ? detail.roomName : '战绩详情'}}</text><text class="detail-meta" wx:if="{{detail}}">{{detail.modeText}} · {{detail.displayTime}}</text></view><text class="detail-close" bindtap="closeDetail">✕</text></view>
    <view class="state-card" wx:if="{{detailLoading}}"><view class="weui-loading"></view><text>正在读取详情</text></view>
    <scroll-view class="detail-scroll" scroll-y wx:elif="{{detail}}">
      <view class="ranking-card">
        <text class="section-label">最终排名</text>
        <view class="player-row {{item.isMe ? 'is-me' : ''}}" wx:for="{{detailPlayers}}" wx:key="openid">
          <text class="rank-number">{{index + 1}}</text><image class="player-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image><text class="player-name">{{item.nickname}}{{item.isMe ? '（我）' : ''}}</text><text class="player-score {{item.scoreClass}}">{{item.displayScore}}</text>
        </view>
      </view>
      <view class="ranking-card" wx:if="{{detail.mode === 'bet' && detail.betSummary}}">
        <text class="section-label">奖池摘要</text>
        <view class="summary-row"><text>累计下注</text><text>{{detail.betSummary.totalBet}} 分</text></view>
        <view class="summary-row"><text>累计领取</text><text>{{detail.betSummary.totalClaimed}} 分</text></view>
        <view class="claim-row" wx:for="{{detail.betSummary.claimEvents}}" wx:key="operationId"><text>{{item.nickname}} 收取奖池</text><text>+{{item.amount}}</text></view>
      </view>
      <view class="detail-spacer"></view>
    </scroll-view>
    <view class="detail-actions" wx:if="{{detail}}"><button class="detail-button secondary" open-type="share"><text>分享</text></button><button class="detail-button primary" bindtap="savePoster"><text>{{savingPoster ? '生成中…' : '保存海报'}}</text></button></view>
  </view>
  <canvas type="2d" id="historyPoster" class="history-poster"></canvas>
</view>
