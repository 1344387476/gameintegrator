<view class="record-page theme-{{appearanceTheme}} motion-{{motionLevel}}" style="padding-top: {{pageSafeTop}}px;">
  <view class="record-intro">
    <text class="record-kicker">GAME HISTORY</text>
    <text class="record-title">每一局，都有迹可循</text>
    <text class="record-subtitle">仅展示结算后你参与的对局</text>
  </view>

  <view class="state-card" wx:if="{{loading}}"><view class="weui-loading"></view><text>正在加载战绩</text></view>
  <view class="state-card error" wx:elif="{{errorText && items.length === 0}}" bindtap="retryLoad"><text>{{errorText}}</text><text class="retry">点击重试</text></view>
  <view class="state-card empty" wx:elif="{{!loading && items.length === 0}}"><text class="empty-icon">◎</text><text class="empty-title">还没有战绩</text><text class="empty-subtitle">完成并结算一局后，记录会出现在这里</text></view>

  <view class="history-list" wx:else>
    <view class="history-card motion-card" wx:for="{{items}}" wx:key="historyId" data-id="{{item.historyId}}" bindtap="openDetail" hover-class="history-card--pressed" style="animation-delay: {{item.motionDelay}}ms;">
      <view class="history-card__top"><text class="history-card__name">{{item.roomName}}</text><text class="result-pill {{item.resultClass}}">{{item.resultText}}</text></view>
      <view class="history-card__meta"><text>{{item.displayTime}}</text><text>·</text><text>{{item.modeText}}</text><text>·</text><text>{{item.participantCount}} 人</text></view>
      <view class="history-card__bottom"><text class="history-card__label">我的积分</text><text class="history-score {{item.resultClass}} {{item.scoreCompact ? 'compact-number' : ''}}">{{item.displayScore}}</text><text class="history-arrow">›</text></view>
    </view>
    <view class="load-more" wx:if="{{loadingMore}}"><view class="weui-loading"></view><text>加载更多</text></view>
    <view class="load-more" wx:elif="{{!hasMore}}">已显示全部战绩</view>
    <view class="load-more retry" wx:elif="{{errorText}}" bindtap="retryLoad">加载失败，点击重试</view>
  </view>

  <history-detail
    visible="{{showDetail}}"
    loading="{{detailLoading}}"
    theme="{{appearanceTheme}}"
    detail="{{detail}}"
    players="{{detailPlayers}}"
    bind:close="closeDetail"
  />
</view>
