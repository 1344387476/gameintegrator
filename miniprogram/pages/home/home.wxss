.loading-mask { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; background: var(--page-bg); opacity: .96; }
.loading-content { display: flex; flex-direction: column; align-items: center; }
.loading-text { margin-top: 22rpx; color: #8e8e93; font-size: 25rpx; }
.hidden { opacity: 0; pointer-events: none; }
.container { position: relative; width: 100vw; min-height: 100vh; overflow: hidden; background: #f2f2f7; background: linear-gradient(180deg,var(--page-top) 0%,var(--page-bg) 55%); color: var(--text-primary); transition: background-color 180ms ease,color 180ms ease; }
.content { display: flex; min-height: 100vh; flex-direction: column; }
.top-section { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 70rpx 52rpx 36rpx; box-sizing: border-box; }
.welcome-section { margin-bottom: 38rpx; text-align: center; }
.welcome-title { display: block; margin-bottom: 12rpx; color: #23955b; font-size: 18rpx; font-weight: 650; letter-spacing: 3rpx; }
.app-name { display: block; color: #1c1c1e; font-size: 58rpx; font-weight: 750; letter-spacing: -2rpx; line-height: 1.15; }
.welcome-subtitle { display: block; margin-top: 16rpx; color: #8e8e93; font-size: 25rpx; }
.logo-section { position: relative; display: flex; width: 196rpx; height: 196rpx; align-items: center; justify-content: center; margin-bottom: 36rpx; }
.avatar-btn { display: flex; width: 160rpx; height: 160rpx; min-width: 160rpx; min-height: 160rpx; align-items: center; justify-content: center; margin: 0; padding: 0; overflow: hidden; box-sizing: border-box; border: 0; border-radius: 50%; background: transparent; line-height: 1; box-shadow: none; }
.avatar-btn::after { border: 0; }
.avatar-btn { transition: transform var(--motion-fast,140ms) var(--motion-ease-standard,ease), opacity var(--motion-fast,140ms) ease; }
.avatar-pressed { opacity: .84; transform: scale(.955); }
.avatar { display: block; flex: none; width: 160rpx; height: 160rpx; border: 0; border-radius: 50%; background: #e5e5ea; }
.avatar-edit-mark { position: absolute; right: 0; bottom: 4rpx; z-index: 3; padding: 8rpx 14rpx; border: 4rpx solid #f7faf8; border-radius: 999rpx; background: #1c1c1e; color: #fff; font-size: 19rpx; font-weight: 600; pointer-events: none; }
.input-section, .button-group { width: 100%; max-width: 580rpx; }
.input-section { margin-bottom: 24rpx; }
.nickname-input { width: 100%; height: 100rpx; padding: 0 32rpx; box-sizing: border-box; border: 1rpx solid var(--separator); border-radius: 24rpx; background: var(--surface-raised); color: #1c1c1e; font-size: 29rpx; text-align: center; box-shadow: 0 5rpx 18rpx rgba(28,28,30,.035); backdrop-filter: blur(14rpx); -webkit-backdrop-filter: blur(14rpx); }
.nickname-input:focus { border-color: rgba(52,199,89,.55); background: #fff; box-shadow: 0 0 0 6rpx rgba(52,199,89,.09); }
.button-group { display: flex; flex-direction: column; gap: 18rpx; }
.weui-btn { display: flex; width: 100%; height: 98rpx; align-items: center; justify-content: center; gap: 14rpx; border-radius: 24rpx; font-size: 29rpx; font-weight: 650; transition: transform 140ms ease, opacity 140ms ease; }
.button-label { color: inherit; line-height: 1; }
.button-pressed { opacity: .72; transform: scale(.985); }
.weui-btn_primary { background: #28a860; color: #fff; box-shadow: 0 10rpx 24rpx rgba(40,168,96,.2); }
.weui-btn_default { border: 1rpx solid var(--separator); background: var(--surface-raised); color: #1c1c1e; box-shadow: 0 5rpx 18rpx rgba(28,28,30,.035); backdrop-filter: blur(14rpx); -webkit-backdrop-filter: blur(14rpx); }
.weui-btn_primary .button-label { color: #fff; }
.weui-btn_default .button-label { color: #1c1c1e; }
.active-room-tip { display: flex; min-height: 112rpx; align-items: center; justify-content: space-between; padding: 22rpx 28rpx; box-sizing: border-box; border: 1rpx solid rgba(40,168,96,.18); border-radius: 24rpx; background: #eef9f2; }
.active-room-tip_active { opacity: .7; transform: scale(.985); }
.active-room-tip__content { display: flex; flex-direction: column; gap: 5rpx; }
.active-room-tip__title { color: #1c1c1e; font-size: 28rpx; font-weight: 650; }
.active-room-tip__action { color: #248d52; font-size: 23rpx; }
.active-room-tip__arrow { color: #248d52; font-size: 44rpx; }
.bottom-section { padding: 18rpx 40rpx calc(28rpx + env(safe-area-inset-bottom)); }
.footer-text { color: #aeaeb2; font-size: 22rpx; }
.modal-mask { position: fixed; inset: 0; z-index: 999; visibility: hidden; background: rgba(0,0,0,.28); opacity: 0; transition: opacity 220ms ease; }
.modal-mask.show { visibility: visible; opacity: 1; }
.modal-content { position: fixed; right: 0; bottom: 0; left: 0; z-index: 1000; padding-bottom: env(safe-area-inset-bottom); border-radius: 34rpx 34rpx 0 0; background: #f7f7fa; box-shadow: 0 -20rpx 60rpx rgba(0,0,0,.14); opacity: 0; pointer-events: none; transform: translate3d(0,105%,0); transition: transform var(--motion-slow,300ms) var(--motion-ease-out,cubic-bezier(.22,.8,.25,1)), opacity var(--motion-base,220ms) ease; will-change: transform; }
.modal-content.show { opacity: 1; pointer-events: auto; transform: translate3d(0,0,0); }
.sheet-handle { width: 72rpx; height: 10rpx; margin: 14rpx auto 2rpx; border-radius: 99rpx; background: #d1d1d6; }
.modal-header { padding: 26rpx 40rpx 22rpx; color: #1c1c1e; font-size: 34rpx; font-weight: 700; text-align: center; }
.modal-body { padding: 22rpx 38rpx 44rpx; }
.room-name-section { margin-bottom: 34rpx; }
.room-name-input { width: 100%; height: 98rpx; padding: 0 28rpx; box-sizing: border-box; border: 1rpx solid var(--separator); border-radius: 22rpx; background: var(--surface-raised); color: #1c1c1e; font-size: 28rpx; }
.mode-title { margin: 0 4rpx 16rpx; color: #6e6e73; font-size: 24rpx; font-weight: 600; }
.mode-options { display: flex; gap: 18rpx; }
.mode-option { position: relative; display: flex; flex: 1; min-height: 120rpx; align-items: center; padding: 22rpx; box-sizing: border-box; border: 2rpx solid transparent; border-radius: 22rpx; background: #fff; }
.mode-option.active { border-color: #34c759; background: #f2fbf5; }
.mode-copy { display: flex; flex-direction: column; gap: 8rpx; }
.mode-text { color: #1c1c1e; font-size: 28rpx; font-weight: 650; }
.mode-description { color: #8e8e93; font-size: 21rpx; }
.mode-check { position: absolute; top: 14rpx; right: 16rpx; display: flex; width: 32rpx; height: 32rpx; align-items: center; justify-content: center; border-radius: 50%; background: #34c759; color: #fff; font-size: 20rpx; }
.create-btn-section { margin-top: 34rpx; }
.create-submit-btn { height: 98rpx; }
@media (max-height: 700px) { .top-section { padding-top: 34rpx; } .welcome-section { margin-bottom: 22rpx; } .welcome-subtitle { display: none; } .logo-section { margin-bottom: 24rpx; } }

.appearance-button { position: absolute; top: 22rpx; right: 34rpx; z-index: 5; display: flex; width: 68rpx; height: 68rpx; align-items: center; justify-content: center; border: 1rpx solid var(--separator); border-radius: 50%; background: var(--glass); box-shadow: 0 8rpx 22rpx var(--shadow); backdrop-filter: blur(18rpx); -webkit-backdrop-filter: blur(18rpx); }
.appearance-button__icon { color: var(--text-primary); font-size: 34rpx; line-height: 1; }
.appearance-sheet { background: var(--surface-secondary); color: var(--text-primary); }
.appearance-options { margin: 0 32rpx 38rpx; overflow: hidden; border: 1rpx solid var(--separator); border-radius: 24rpx; background: var(--surface); }
.appearance-option { display: flex; min-height: 112rpx; align-items: center; padding: 16rpx 24rpx; border-bottom: 1rpx solid var(--separator); }
.appearance-option:last-child { border-bottom: 0; }
.appearance-option:active { background: var(--surface-secondary); }
.appearance-option__preview { width: 62rpx; height: 62rpx; margin-right: 20rpx; border: 2rpx solid var(--separator); border-radius: 18rpx; box-shadow: inset 0 0 0 12rpx rgba(128,128,128,.05); }
.preview-light { background: #f2f2f7; }
.preview-dark { background: #141715; }
.appearance-option__copy { display: flex; flex: 1; flex-direction: column; gap: 5rpx; }
.appearance-option__title { color: var(--text-primary); font-size: 28rpx; font-weight: 650; }
.appearance-option__desc { color: var(--text-tertiary); font-size: 22rpx; }
.appearance-option__check { width: 42rpx; color: var(--accent); font-size: 30rpx; font-weight: 700; text-align: center; }

.theme-dark .welcome-title { color: var(--accent); }
.theme-dark .app-name, .theme-dark .active-room-tip__title, .theme-dark .mode-text, .theme-dark .modal-header { color: var(--text-primary); }
.theme-dark .welcome-subtitle, .theme-dark .footer-text, .theme-dark .mode-description, .theme-dark .mode-title { color: var(--text-tertiary); }
.theme-dark .avatar, .theme-dark .nickname-input, .theme-dark .room-name-input, .theme-dark .weui-btn_default, .theme-dark .mode-option { background: var(--surface); border-color: var(--separator); color: var(--text-primary); box-shadow: 0 8rpx 24rpx var(--shadow); }
.theme-dark .avatar-btn { border: 0; background: transparent; box-shadow: none; }
.theme-dark .avatar-edit-mark { border-color: var(--page-top); background: #f2f2f7; color: #1c1c1e; }
.theme-dark .weui-btn_primary { background: #32b768; }
.theme-dark .weui-btn_default .button-label { color: var(--text-primary); }
.theme-dark .active-room-tip, .theme-dark .mode-option.active { border-color: rgba(72,209,123,.32); background: var(--accent-soft); }
.theme-dark .modal-content { background: var(--surface-secondary); box-shadow: 0 -24rpx 70rpx var(--shadow); }
.theme-dark .modal-mask { background: var(--mask); }

/* 输入框已有 maxlength，布局层仍为历史值和系统自动填充提供防溢出兜底。 */
.welcome-section,.input-section,.button-group,.active-room-tip,.mode-option,.mode-copy,.appearance-option__copy { min-width: 0; box-sizing: border-box; }
.welcome-title,.app-name,.welcome-subtitle,.footer-text { max-width: 100%; overflow-wrap: anywhere; }
.active-room-tip__content,.mode-copy,.appearance-option__copy { min-width: 0; flex: 1; }
.active-room-tip__title,.active-room-tip__action,.mode-text,.mode-description,.appearance-option__title,.appearance-option__desc { display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.room-name-input,.nickname-input { min-width: 0; }

/* 首屏只编排必要元素；加载完成后再开始，避免动画在遮罩下提前播完。 */
.motion-full.motion-visible .welcome-section,
.motion-full.motion-visible .logo-section,
.motion-full.motion-visible .input-section,
.motion-full.motion-visible .button-group,
.motion-full.motion-visible .bottom-section { animation: home-enter var(--motion-slow) var(--motion-ease-out) both; }
.motion-full.motion-visible .logo-section { animation-delay: 55ms; }
.motion-full.motion-visible .input-section { animation-delay: 105ms; }
.motion-full.motion-visible .button-group { animation-delay: 150ms; }
.motion-full.motion-visible .bottom-section { animation-delay: 195ms; }
@keyframes home-enter { from { opacity: 0; transform: translate3d(0,22rpx,0) scale(.985); } to { opacity: 1; transform: translate3d(0,0,0) scale(1); } }

.motion-reduced.motion-visible .welcome-section,
.motion-reduced.motion-visible .logo-section,
.motion-reduced.motion-visible .input-section,
.motion-reduced.motion-visible .button-group { animation: simple-fade var(--motion-base) ease-out both; }
@keyframes simple-fade { from { opacity: 0; } to { opacity: 1; } }

/* 统一 iOS Sheet：透明、克制，不依赖明显线条制造层次。 */
.modal-mask { background: rgba(10,12,11,.3); backdrop-filter: blur(8rpx); -webkit-backdrop-filter: blur(8rpx); }
.modal-content { overflow: hidden; border: 1rpx solid var(--separator); border-bottom: 0; background: var(--glass); box-shadow: 0 -18rpx 52rpx rgba(0,0,0,.12); backdrop-filter: blur(30rpx); -webkit-backdrop-filter: blur(30rpx); }
.sheet-handle { height: 8rpx; background: var(--separator); }
.modal-header { padding: 24rpx 40rpx 20rpx; color: var(--text-primary); font-size: 31rpx; font-weight: 700; }
.modal-body { padding: 18rpx 34rpx 38rpx; }
.room-name-input { border-color: var(--separator); background: var(--surface-raised); box-shadow: none; }
.mode-title { color: var(--text-secondary); }
.mode-option { border: 1rpx solid transparent; background: rgba(127,127,127,.065); box-shadow: none; transition: transform var(--motion-fast) var(--motion-ease-standard), background-color var(--motion-base) ease; }
.mode-option.active { border-color: rgba(40,168,96,.18); background: var(--accent-soft); box-shadow: none; }
.appearance-options { display: flex; flex-direction: column; gap: 12rpx; margin: 4rpx 30rpx 34rpx; overflow: visible; border: 0; border-radius: 0; background: transparent; }
.appearance-option { min-height: 100rpx; padding: 12rpx 20rpx; border: 1rpx solid var(--separator); border-radius: 20rpx; background: var(--surface-raised); transition: transform var(--motion-fast) var(--motion-ease-standard), opacity var(--motion-fast) ease; }
.appearance-option:last-child { border-bottom: 1rpx solid var(--separator); }
.appearance-option:active { opacity: .76; transform: scale(.985); }
.theme-dark .modal-content { background: var(--glass); box-shadow: 0 -18rpx 56rpx rgba(0,0,0,.28); }
