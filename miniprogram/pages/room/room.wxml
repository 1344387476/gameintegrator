<!--pages/room/room.wxml-->
<view class="room-page theme-{{appearanceTheme}} motion-{{motionLevel}}">
<view class="main-container">
  <view class="left-section">
    <view class="members-section">
      <scroll-view class="members-scroll" scroll-y scroll-with-animation enhanced show-scrollbar="{{false}}">
        <view class="sidebar-list">
          <!-- 邀请好友卡片 -->
          <view class="capsule-card invite-card" bindtap="showQrcode">
            <image class="invite-avatar-img" src="/images/weixin.png"></image>
            <text class="capsule-label">邀请</text>
          </view>
          
          <!-- 玩家胶囊卡片 -->
          <view class="capsule-card {{item.openid === room.creator ? 'is-creator' : ''}} {{item.openid === myOpenid ? 'is-me' : ''}} {{item.openid === receiveTargetOpenid ? 'claim-target claim-target-' + receiveAnimationPhase : ''}}"
                wx:for="{{room.members}}" wx:key="openid" bindtap="handleMemberTap" data-index="{{index}}" hover-class="card-pressed">
            <!-- 房主皇冠 - 右上角 -->
            <view class="crown-badge" wx:if="{{item.openid === room.creator}}">👑</view>
            
            <!-- 头像 -->
            <image class="capsule-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" data-file-id="{{item.avatarFileID}}" binderror="handleAvatarError"></image>
            
            <!-- 昵称 -->
            <text class="capsule-name">{{item.name}}</text>
            
            <!-- 分数胶囊 (0分隐藏) -->
            <view class="score-capsule {{item.score > 0 ? 'positive' : 'negative'}}" wx:if="{{item.score !== 0}}">
              <text class="score-capsule-text">{{item.score > 0 ? '+' : ''}}{{item.score}}</text>
            </view>
            <view class="claim-reward-badge" wx:if="{{showReceiveAnimation && receiveAnimationPhase === 'reward' && item.openid === receiveTargetOpenid}}">+{{receiveAmount}}</view>
          </view>
          

        </view>
      </scroll-view>
    </view>

  </view>

  <view class="right-section">
    <!-- 下注模式面板 -->
    <view class="bet-panel-wrapper" wx:if="{{room.gameMode === 'bet'}}">
      <!-- 公共奖池卡片 -->
      <view class="prize-pool-card-modern {{showReceiveAnimation ? 'claiming claim-' + receiveAnimationPhase : ''}}" bindtap="transferToPrizePool" hover-class="pool-pressed">
        <!-- 点击区域：奖袋、数字、提示 -->
        <view class="prize-pool-content">
          <!-- 奖袋图标 -->
          <view class="prize-icon-wrap">
            <text class="prize-bag-icon">💰</text>
          </view>
          <!-- 积分数字 -->
          <view class="prize-amount-wrap {{animateAmount ? 'animate' : ''}}">
            <text class="prize-amount-number">{{room.prizePool.total}}</text>
          </view>
          <!-- 提示文字 -->
          <text class="prize-pool-hint">点击转入积分</text>
        </view>
        
        <!-- 收取状态提示 -->
        <view class="prize-receiver-tip {{room.prizePool.receiver ? 'show' : ''}}">
          【{{room.prizePool.receiver}}】已收取
        </view>
        
        <!-- 收取奖池按钮 - 在卡片内部，阻止冒泡 -->
        <view class="collect-pool-btn {{room.prizePool.receiver || gameOperationSubmitting ? 'disabled' : ''}}" wx:if="{{room.status === 'playing'}}" catchtap="onCollectPoolTap" hover-class="control-pressed">
          <text class="collect-pool-text">收取奖池</text>
        </view>
      </view>

      <!-- 游戏操作按钮 - 紧贴奖池下方 -->
      <view class="game-actions-row" wx:if="{{room.status === 'playing'}}">
        <view class="game-action-btn call {{!canFollow || gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handleFollow" hover-class="control-pressed">
          <text class="action-btn-text">跟</text>
        </view>
        <view class="game-action-btn pass {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handlePass" hover-class="control-pressed">
          <text class="action-btn-text">过</text>
        </view>
        <view class="game-action-btn allin {{!room.allInValue || gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handleAllIn" hover-class="control-pressed">
          <text class="action-btn-text">All-in</text>
        </view>
      </view>
    </view>


    <view class="chat-section {{room.gameMode === 'normal' ? 'has-bottom-action' : ''}}">
      <view class="message-panel">
        <view class="record-filter-bar">
          <text class="record-filter-title">信息记录</text>
          <view class="record-filter" aria-label="流水筛选">
            <view class="record-filter-item {{recordFilter === 'all' ? 'active' : ''}}" bindtap="onRecordFilterChange" data-filter="all" hover-class="control-pressed">全部</view>
            <view class="record-filter-item {{recordFilter === 'mine' ? 'active' : ''}}" bindtap="onRecordFilterChange" data-filter="mine" hover-class="control-pressed">关于我</view>
          </view>
        </view>
        <scroll-view
          class="chat-scroll"
          scroll-y
          scroll-with-animation
          scroll-into-view="{{scrollIntoView}}"
          bindscrolltoupper="onScrollToUpper">
          <view class="chat-list">
            <view class="records-empty" wx:if="{{room.records.length === 0 && recordFilter === 'mine'}}">暂无与我相关的记录</view>
            <view
              wx:if="{{loadedRecords.length > 0 && (loadingMoreText || isLoadingMore)}}"
              class="load-more-container {{hasMore ? 'clickable' : ''}}"
              bindtap="onLoadingMoreTap">
              <block wx:if="{{isLoadingMore}}">
                <text class="loading-icon">⟳</text>
                <text>加载中...</text>
              </block>
              <block wx:else>
                <text>{{loadingMoreText}}</text>
              </block>
            </view>
            <view id="record-{{index}}" class="chat-message {{item.isMe ? 'mine' : 'others'}} {{item.isSystem ? 'system' : ''}}" wx:for="{{room.records}}" wx:key="recordKey" bindtap="onRecordTap" data-record="{{item}}">
              <view class="message-component">
                <view class="avatar-name-container" wx:if="{{!item.isSystem}}">
                  <text class="message-username">{{item.detail.operator}}</text>
                  <view class="avatar-container {{room.gameMode === 'bet' ? 'bet-avatar' : ''}}">
                    <image class="single-avatar {{item.isMe ? 'avatar-me' : 'avatar-other'}}" src="{{item.detail.operatorAvatar || '/images/avatar.png'}}"></image>
                  </view>
                </view>
                <view class="bubble-time-container">
                  <text class="message-time">{{item.time}}</text>
                  <view class="bubble {{item.isMe ? 'mine' : 'others'}} {{item.isSystem ? 'system' : ''}} {{item.isReceive ? 'receive' : ''}}">
                    <text class="message-content {{item.isReceive ? 'receive-text' : ''}}">
                      <block wx:if="{{item.segments}}">
                        <text wx:for="{{item.segments}}" wx:for-item="segment" wx:key="index" class="{{segment.isMe ? 'me' : ''}} {{segment.isAmount ? 'transfer-amount' : ''}}">{{segment.text}}</text>
                      </block>
                      <block wx:else>{{item.processedDescription || item.description}}</block>
                    </text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="bottom-actions-container" wx:if="{{room.gameMode === 'normal'}}">
        <view class="action-btn expense-btn {{room.status !== 'playing' ? 'disabled' : ''}}" bindtap="handleExpenseBtn" hover-class="control-pressed">
          <text class="btn-text">批量支出</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全屏悬浮拖动菜单 (Floating Action Button) - 放在最外层确保 iOS z-index 正确 -->
  <movable-area class="fab-area">
    <movable-view
      class="fab-container"
      direction="all"
      x="{{fabX}}"
      y="{{fabY}}"
      inertia
      friction="2"
      damping="20"
      out-of-bounds="{{false}}"
      bindchange="onFabChange"
      width="100"
      height="100">
      <!-- 子按钮菜单 -->
      <view class="fab-menu {{fabOnLeft ? 'expand-right' : 'expand-left'}} {{fabExpanded ? 'expanded' : ''}}">
        <!-- 设置按钮 -->
        <view class="fab-sub-btn settings" wx:if="{{isCreator}}" bindtap="openSettingsModal" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">设置</text>
        </view>
        <!-- 结算按钮 -->
        <view class="fab-sub-btn settle {{room.status !== 'playing' ? 'disabled' : ''}}" bindtap="handleSettleBtn" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">结算</text>
        </view>
        <!-- 解散按钮（仅房主可见） -->
        <view class="fab-sub-btn dismiss" wx:if="{{isCreator && room.status === 'playing'}}" bindtap="openDismissConfirm" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">解散</text>
        </view>
        <!-- 退出按钮 -->
        <view class="fab-sub-btn exit" bindtap="openExitConfirm" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">退出</text>
        </view>
      </view>
      <!-- 主按钮 -->
      <view class="fab-main" bindtap="toggleFab" hover-class="control-pressed">
        <text class="fab-main-icon {{fabExpanded ? 'rotated' : ''}}">☰</text>
      </view>
    </movable-view>
  </movable-area>
</view>

<view class="float-animation-container" wx:if="{{showFloatAnimation}}">
  <text class="float-amount" style="left: {{floatLeft}}px; top: {{floatTop}}px;">+{{floatAmount}}</text>
</view>

<view class="receive-animation-container {{receiveAnimationRole}} phase-{{receiveAnimationPhase}}" wx:if="{{showReceiveAnimation}}">
  <view class="claim-orb" wx:if="{{claimMotionReady && receiveAnimationRole === 'full'}}" style="left: {{claimStartX}}px; top: {{claimStartY}}px; --claim-x: {{claimDeltaX}}px; --claim-y: {{claimDeltaY}}px;"></view>
  <view class="reward-focus">
    <view class="reward-particle particle-{{index}}" wx:for="{{confettiList}}" wx:key="id"></view>
    <view class="reward-token">
      <text class="reward-token__amount">+{{receiveAmount}}</text>
      <text class="reward-token__name">{{receivePlayerName}} 收取奖池</text>
    </view>
  </view>
</view>
<view class="modal-mask {{showExpenseModal ? 'show' : ''}}" wx:if="{{showExpenseModal}}" bindtap="closeExpenseModal"></view>
<view class="expense-modal {{showExpenseModal ? 'show' : ''}}" wx:if="{{showExpenseModal}}">
  <view class="modal-header">
    <text class="modal-title">批量支出</text>
    <text class="modal-close" bindtap="closeExpenseModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="expense-info">
      <view class="info-row">
        <text class="info-label">支出方:</text>
        <text class="info-value">{{currentUser}}</text>
      </view>
    </view>
    <view class="expense-list">
      <view class="expense-item" wx:for="{{room.members}}" wx:key="name" wx:if="{{item.openid !== myOpenid}}">
        <view class="player-info">
          <image class="player-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}"></image>
          <text class="player-name">{{item.name}}</text>
        </view>
        <view class="input-section">
          <input class="score-input" type="digit" placeholder="0" value="{{expenseAmounts[item.name] || ''}}" data-name="{{item.name}}" bindinput="onExpenseAmountInput" />
          <text class="score-unit">积分</text>
        </view>
      </view>
    </view>
    <view class="expense-total">
      <text class="total-label">总计支出:</text>
      <text class="total-value">{{expenseTotal || 0}} 积分</text>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeExpenseModal">取消</view>
      <view class="action-btn confirm" bindtap="confirmExpense">确认支出</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showTransferPicker ? 'show' : ''}}" wx:if="{{showTransferPicker}}" bindtap="closeTransferPicker"></view>
<view class="transfer-picker-modal {{showTransferPicker ? 'show' : ''}}" wx:if="{{showTransferPicker}}">
  <view class="modal-header"><text class="modal-title">选择接收玩家</text><text class="modal-close" bindtap="closeTransferPicker">✕</text></view>
  <scroll-view class="transfer-player-list" scroll-y>
    <view class="transfer-player-row" wx:for="{{room.members}}" wx:key="openid" wx:if="{{item.openid !== myOpenid && !item.isExited}}" data-openid="{{item.openid}}" bindtap="selectTransferTarget" hover-class="transfer-player-row--pressed">
      <image class="player-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image><text class="player-name">{{item.name}}</text><text class="player-current-score">{{item.score > 0 ? '+' : ''}}{{item.score}}</text><text class="history-arrow">›</text>
    </view>
  </scroll-view>
</view>
<view class="modal-mask {{showTransferModal ? 'show' : ''}}" wx:if="{{showTransferModal}}" bindtap="closeTransferModal"></view>
<view class="transfer-modal {{showTransferModal ? 'show' : ''}}" wx:if="{{showTransferModal}}">
  <view class="modal-header">
    <text class="modal-title">转账</text>
    <text class="modal-close" bindtap="closeTransferModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="transfer-info">
      <view class="info-row">
        <text class="info-label">转出方:</text>
        <text class="info-value">{{currentUser}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">接收方:</text>
        <text class="info-value">{{targetMember}}</text>
      </view>
    </view>
    <view class="input-section">
      <input class="score-input {{showInputError ? 'error' : ''}}" type="digit" placeholder="请输入积分（正整数）" value="{{transferAmount}}" bindinput="onTransferAmountInput" />
      <text class="error-tip" wx:if="{{showInputError}}">仅支持正整数积分</text>
    </view>
    <view class="modal-actions">
<view class="action-btn cancel {{transferSubmitting ? 'disabled' : ''}}" bindtap="{{transferSubmitting ? '' : 'closeTransferModal'}}">取消</view>
      <view class="action-btn confirm {{transferSubmitting ? 'disabled' : ''}}" bindtap="{{transferSubmitting ? '' : 'confirmTransfer'}}">
        {{transferSubmitting ? '转账中...' : '确认转账'}}
      </view>
    </view>
  </view>
</view>

<view class="modal-mask {{showPrizeModal ? 'show' : ''}}" wx:if="{{showPrizeModal}}" bindtap="closePrizeModal"></view>
<view class="prize-modal {{showPrizeModal ? 'show' : ''}}" wx:if="{{showPrizeModal}}">
  <view class="modal-header">
    <text class="modal-title">转入奖池</text>
    <text class="modal-close" bindtap="closePrizeModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="prize-input-info">
      <text class="info-label">操作玩家:</text>
      <text class="info-value">{{currentUser}}</text>
    </view>
    <view class="input-section">
      <input class="score-input {{showInputError ? 'error' : ''}}" type="digit" placeholder="请输入积分（正整数）" value="{{prizeAmount}}" bindinput="onPrizeAmountInput" />
      <text class="error-tip" wx:if="{{showInputError}}">仅支持正整数积分</text>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closePrizeModal">取消</view>
      <view class="action-btn confirm {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmPrizeTransfer">{{gameOperationSubmitting ? '转入中…' : '确认转入'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showReceiveModal ? 'show' : ''}}" wx:if="{{showReceiveModal}}" bindtap="closeReceiveModal"></view>
<view class="confirm-modal {{showReceiveModal ? 'show' : ''}}" wx:if="{{showReceiveModal}}">
  <view class="modal-header">
    <text class="modal-title">确认收取</text>
    <text class="modal-close" bindtap="closeReceiveModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认收取奖池全部【{{room.prizePool.total}}】积分？</view>
    <view class="confirm-sub">收取后奖池清空</view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeReceiveModal">取消</view>
      <view class="action-btn confirm {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmReceive">{{gameOperationSubmitting ? '收取中…' : '确认收取'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showTipModal ? 'show' : ''}}" wx:if="{{showTipModal}}"></view>
<view class="tip-modal {{showTipModal ? 'show' : ''}}" wx:if="{{showTipModal}}">
  <view class="tip-content">
    <text class="tip-text">{{tipText}}</text>
  </view>
</view>

<view class="modal-mask {{showSettleConfirm ? 'show' : ''}}" wx:if="{{showSettleConfirm}}" bindtap="closeSettleConfirm"></view>
<view class="confirm-modal {{showSettleConfirm ? 'show' : ''}}" wx:if="{{showSettleConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认结算</text>
    <text class="modal-close" bindtap="closeSettleConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认结束本局并生成战绩？</view>
    <view class="confirm-sub">结算后所有积分将重置为0</view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeSettleConfirm">取消</view>
      <view class="action-btn confirm" bindtap="confirmSettle">确认结算</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showResultModal ? 'show' : ''}}" wx:if="{{showResultModal}}" bindtap="closeResultModal"></view>
<view class="result-modal {{showResultModal ? 'show' : ''}}" wx:if="{{showResultModal}}">
  <view class="modal-header">
    <text class="result-room-name">{{resultData.roomName}}</text>
    <text class="modal-close" bindtap="closeResultModal">✕</text>
  </view>
  <scroll-view class="result-scroll-view" scroll-y="true" scroll-with-animation>
    <view class="modal-body result-body">
      <!-- 结算信息区域（置顶） -->
      <view class="settlement-info-section">
        <view class="info-header">
          <text class="info-title">结算信息</text>
        </view>
        <view class="info-content" wx:if="{{resultData}}">
          <view class="info-row">
            <text class="info-label">房间名</text>
            <text class="info-value bold-text">{{resultData.roomName}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">结算时间</text>
            <text class="info-value">{{resultData.settlementTime}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">房间模式</text>
            <text class="info-value mode-badge result-mode-badge {{resultData.roomMode === '下注模式' ? 'bet-mode' : 'normal-mode'}}">{{resultData.roomMode}}</text>
          </view>
          <view class="info-row" wx:if="{{resultData.creator}}">
            <text class="info-label">结算触发人</text>
            <text class="info-value">{{resultData.creator}}</text>
          </view>
          <block wx:if="{{resultData.roomMode === '下注模式' && resultData.prizePoolInfo}}">
            <view class="info-row">
              <text class="info-label">奖池总额</text>
              <text class="info-value prize-amount">{{resultData.prizePoolInfo.totalPrizePool}} 积分</text>
            </view>
            <view class="info-row" wx:if="{{resultData.prizePoolInfo.receiver}}">
              <text class="info-label">收取人</text>
              <text class="info-value">{{resultData.prizePoolInfo.receiver}}</text>
            </view>
          </block>
        </view>
        <view class="no-info-tip" wx:elif="{{!resultData}}">
          <text class="tip-text">暂无结算事件信息</text>
        </view>
      </view>

      <!-- 分隔线 -->
      <view class="section-divider"></view>

      <!-- 赢家板块 -->
      <view class="result-section" wx:if="{{resultData.winners.length > 0}}">
        <view class="section-title">
          <view class="title-icon win-icon"></view>
          <text class="title-text">赢家</text>
        </view>
        <view class="bar-chart-container-vertical">
          <view class="chart-item-horizontal" wx:for="{{resultData.winners}}" wx:key="playerName">
            <image class="player-avatar-mini" src="{{item.avatarUrl || '/images/avatar.png'}}"></image>
            <text class="player-name-mini">{{item.playerName}}</text>
            <view class="bar-container">
              <view class="bar win-bar-horizontal" style="width: {{item.barHeight}}px;"></view>
            </view>
            <text class="score-label win-score">{{item.displayScore}}</text>
          </view>
        </view>
      </view>

      <!-- 输家板块 -->
      <view class="result-section" wx:if="{{resultData.losers.length > 0}}">
        <view class="section-title">
          <view class="title-icon lose-icon"></view>
          <text class="title-text">输家</text>
        </view>
        <view class="bar-chart-container-vertical">
          <view class="chart-item-horizontal" wx:for="{{resultData.losers}}" wx:key="playerName">
            <image class="player-avatar-mini" src="{{item.avatarUrl || '/images/avatar.png'}}"></image>
            <text class="player-name-mini">{{item.playerName}}</text>
            <view class="bar-container">
              <view class="bar lose-bar-horizontal" style="width: {{item.barHeight}}px;"></view>
            </view>
            <text class="score-label lose-score">{{item.displayScore}}</text>
          </view>
        </view>
      </view>

      <!-- 无输赢提示 -->
      <view class="no-result-tip" wx:if="{{resultData.winners.length === 0 && resultData.losers.length === 0}}">
        <text class="tip-text">本局无输赢</text>
      </view>
      <view class="no-winners-tip" wx:elif="{{resultData.winners.length === 0 && resultData.losers.length > 0}}">
        <text class="tip-text">本局无赢家</text>
      </view>
      <view class="no-losers-tip" wx:elif="{{resultData.winners.length > 0 && resultData.losers.length === 0}}">
        <text class="tip-text">本局无输家</text>
      </view>
    </view>
  </scroll-view>

  <!-- 底部按钮区域（固定，不滚动） -->
  <view class="result-actions">
    <view class="action-btn share-btn" bindtap="shareResult"><text>分享</text></view>
    <view class="action-btn save-btn" bindtap="saveResultToAlbum"><text>保存到相册</text></view>
  </view>
</view>

<canvas type="2d" id="resultCanvas" class="result-canvas-hidden" wx:if="{{showResultModal}}"></canvas>

<view class="all-in-tip {{showAllInTip ? 'show' : ''}}" wx:if="{{showAllInTip}}">
  <text class="tip-content-text">请先设置all in值</text>
</view>

<view class="modal-mask {{showExitConfirm ? 'show' : ''}}" wx:if="{{showExitConfirm}}" bindtap="closeExitConfirm"></view>
<view class="confirm-modal {{showExitConfirm ? 'show' : ''}}" wx:if="{{showExitConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认退出</text>
    <text class="modal-close" bindtap="closeExitConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认退出本房间？</view>
    <view class="confirm-sub">退出后需要重新扫码才能加入</view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeExitConfirm">取消</view>
      <view class="action-btn confirm" bindtap="confirmExit">确认退出</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showDismissConfirm ? 'show' : ''}}" wx:if="{{showDismissConfirm}}" bindtap="closeDismissConfirm"></view>
<view class="confirm-modal {{showDismissConfirm ? 'show' : ''}}" wx:if="{{showDismissConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认解散</text>
    <text class="modal-close" bindtap="closeDismissConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认解散本房间？</view>
    <view class="confirm-sub">房间将直接删除，不结算、也不生成战绩</view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeDismissConfirm">取消</view>
      <view class="action-btn confirm dismiss-confirm-btn" bindtap="confirmDismiss">确认解散</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showSettingsModal ? 'show' : ''}}" wx:if="{{showSettingsModal}}" bindtap="closeSettingsModal"></view>
<view class="settings-modal {{showSettingsModal ? 'show' : ''}}" wx:if="{{showSettingsModal}}">
  <view class="modal-header">
    <text class="modal-title">房间设置</text>
    <text class="modal-close" bindtap="closeSettingsModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="setting-item" wx:if="{{room.gameMode === 'bet'}}">
      <view class="setting-label">All In值设置</view>
      <view class="setting-description">设置全局all in最大值（仅房主可设置）</view>
      <view class="setting-input-wrapper">
        <input class="setting-input" type="digit" placeholder="请输入正整数" value="{{allInInput}}" bindinput="onAllInInput" />
        <text class="setting-unit">分</text>
      </view>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeSettingsModal">取消</view>
      <view class="action-btn confirm" bindtap="saveSettings">确认保存</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showQrcode ? 'show' : ''}}" wx:if="{{showQrcode}}" bindtap="hideQrcode"></view>
<view class="qrcode-modal {{showQrcode ? 'show' : ''}}" wx:if="{{showQrcode}}">
  <view class="qrcode-header">
    <text class="qrcode-title">邀请好友</text>
    <text class="qrcode-close" bindtap="hideQrcode">✕</text>
  </view>
  <view class="qrcode-body">
    <view class="room-info-card">
      <text class="info-name">{{room.roomName}}</text>
      <text class="info-id">房间号: {{room._id}}</text>
    </view>
    
    <!-- 小程序码图片 -->
    <view class="qrcode-image-wrapper">
      <image 
        class="qrcode-image" 
        src="{{qrCodeTempUrl}}"
        mode="aspectFit"
        wx:if="{{qrCodeFileID && !qrCodeError}}"
      ></image>
      
      <!-- 生成中状态 -->
      <view class="qrcode-loading" wx:if="{{isGeneratingQR && !qrCodeFileID}}">
        <text class="loading-text">二维码生成中...</text>
      </view>
      
      <!-- 生成失败状态 -->
      <view class="qrcode-error" wx:if="{{qrCodeError}}" bindtap="getRoomQRCode">
        <text class="error-text">二维码生成失败</text>
        <text class="retry-text">点击重试</text>
      </view>
    </view>
    
    <text class="qrcode-tip" wx:if="{{!qrCodeError}}">微信扫码即可加入房间</text>
    
    <view class="qrcode-actions">
      <view class="action-btn confirm {{!qrCodeFileID || qrCodeError ? 'disabled' : ''}}" bindtap="{{qrCodeFileID && !qrCodeError ? 'saveQrcode' : ''}}"><text>保存图片</text></view>
      <button class="action-btn secondary share-btn" open-type="share"><text>分享给好友</text></button>
    </view>
  </view>
</view>

<!-- 编辑用户信息弹窗 -->
<view class="modal-mask {{showEditProfileModal ? 'show' : ''}}" wx:if="{{showEditProfileModal}}" bindtap="closeEditProfileModal"></view>
<view class="edit-profile-modal {{showEditProfileModal ? 'show' : ''}}" wx:if="{{showEditProfileModal}}">
  <view class="edit-profile-header">
    <text class="edit-profile-title">编辑资料</text>
    <text class="edit-profile-close" bindtap="closeEditProfileModal">✕</text>
  </view>
  <view class="edit-profile-body">
    <!-- 头像编辑 -->
    <view class="avatar-edit-section">
      <button class="avatar-edit-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <view class="edit-avatar-wrapper">
          <image class="edit-avatar-img" src="{{editProfile.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-edit-icon">
            <text class="edit-icon-text">✏️</text>
          </view>
        </view>
      </button>
    </view>
    
    <!-- 昵称编辑 -->
    <view class="nickname-edit-section">
      <text class="edit-label">昵称</text>
      <input 
        class="nickname-input" 
        type="nickname" 
        placeholder="请输入昵称" 
        value="{{editProfile.nickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameConfirm"
      />
    </view>
    
    <!-- 保存按钮 -->
    <view class="edit-profile-actions">
      <view class="action-btn save-profile-btn {{isSavingProfile ? 'disabled' : ''}}" bindtap="{{isSavingProfile ? '' : 'saveProfile'}}">
        <text class="save-btn-text">{{isSavingProfile ? '保存中...' : '保存'}}</text>
      </view>
    </view>
  </view>
</view>
</view><!-- /room-page -->
