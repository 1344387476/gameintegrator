<!--pages/room/room.wxml-->
<view class="room-page theme-{{appearanceTheme}} motion-{{motionLevel}}">
<view class="main-container">
  <view class="scoreboard-section" style="padding-top: {{roomSafeTop}}px;">
    <view class="room-custom-title" style="top: {{customNavTop}}px; height: {{customNavHeight}}px;">
      <text>{{room.roomName}}</text>
    </view>
    <view class="room-invite-btn" style="top: {{roomInviteTop}}px;" bindtap="showQrcode" hover-class="control-pressed">
      <text class="room-invite-plus">+</text>
      <text>邀请</text>
    </view>

    <view class="table-stage-shell">
    <view class="table-stage">
      <view class="table-surface"></view>

      <view class="table-player {{item.seatClass}} {{item.openid === room.creator ? 'is-creator' : ''}} {{item.openid === myOpenid ? 'is-me' : ''}} {{item.isExited ? 'is-exited' : ''}} {{item.openid === receiveTargetOpenid ? 'claim-target claim-target-' + receiveAnimationPhase : ''}}"
            wx:for="{{room.members}}" wx:key="openid" bindtap="handleMemberTap" data-index="{{item.seatIndex}}" hover-class="card-pressed">
        <view class="crown-badge" wx:if="{{item.openid === room.creator}}">👑</view>
        <image class="table-player-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" data-file-id="{{item.avatarFileID}}" binderror="handleAvatarError"></image>
        <view class="offline-badge" wx:if="{{item.isExited}}">已退出</view>
        <text class="table-player-name">{{item.name}}</text>
        <text class="table-player-score {{item.score > 0 ? 'positive' : (item.score < 0 ? 'negative' : 'zero')}} {{item.scoreScroll ? 'compact-number' : ''}}">{{item.score > 0 ? '+' : ''}}{{item.score}}</text>
        <view class="claim-reward-badge" wx:if="{{showReceiveAnimation && receiveAnimationPhase === 'reward' && item.openid === receiveTargetOpenid}}">+{{receiveAmount}}</view>
      </view>

      <view class="table-center normal-center" wx:if="{{room.gameMode === 'normal'}}">
        <text class="center-eyebrow">{{room.leader.isTie ? '并列领先' : '当前领先'}}</text>
        <view class="leader-avatars">
          <image class="leader-avatar {{item.isExited ? 'is-exited' : ''}}" wx:for="{{room.leader.leaders}}" wx:key="openid" src="{{item.avatarUrl || '/images/avatar.png'}}"></image>
          <view class="leader-overflow" wx:if="{{room.leader.overflow > 0}}">+{{room.leader.overflow}}</view>
        </view>
        <text class="leader-name" wx:if="{{!room.leader.isTie && room.leader.leaders.length}}">{{room.leader.leaders[0].name}}</text>
        <text class="leader-score">{{room.leader.score > 0 ? '+' : ''}}{{room.leader.score}}</text>
      </view>

      <view class="table-center bet-center {{showReceiveAnimation ? 'claiming claim-' + receiveAnimationPhase : ''}}" wx:if="{{room.gameMode === 'bet'}}">
        <view class="center-pool" bindtap="transferToPrizePool" hover-class="pool-pressed">
          <text class="center-eyebrow">奖池积分</text>
          <scroll-view class="center-pool-value prize-amount-scroll {{animateAmount ? 'animate' : ''}}" scroll-x enhanced show-scrollbar="{{false}}">
            <text>{{room.prizePool.total}}</text>
          </scroll-view>
          <text class="center-pool-hint">点击转入</text>
        </view>
        <text class="center-receiver" wx:if="{{room.prizePool.receiver}}">{{room.prizePool.receiver}}已收取</text>
        <view class="center-claim-btn {{room.prizePool.receiver || gameOperationSubmitting ? 'disabled' : ''}}" wx:if="{{room.status === 'playing'}}" catchtap="onCollectPoolTap" hover-class="control-pressed">收取奖池</view>
      </view>
    </view>
    </view>
  </view>

  <view class="records-section {{room.gameMode === 'normal' ? 'has-bottom-action' : ''}}">
    <view class="record-filter-bar">
      <text class="record-filter-title">积分流水</text>
      <view class="record-filter" aria-label="流水筛选">
        <view class="record-filter-item {{recordFilter === 'all' ? 'active' : ''}}" bindtap="onRecordFilterChange" data-filter="all" hover-class="control-pressed">全部</view>
        <view class="record-filter-item {{recordFilter === 'mine' ? 'active' : ''}}" bindtap="onRecordFilterChange" data-filter="mine" hover-class="control-pressed">关于我</view>
      </view>
    </view>
    <scroll-view class="records-scroll" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoView}}" bindscrolltoupper="onScrollToUpper">
      <view class="records-list">
        <view class="records-empty" wx:if="{{room.records.length === 0}}">{{recordFilter === 'mine' ? '暂无与我相关的记录' : '暂无积分流水'}}</view>
        <view wx:if="{{loadedRecords.length > 0 && (loadingMoreText || isLoadingMore)}}" class="load-more-container {{hasMore ? 'clickable' : ''}}" bindtap="onLoadingMoreTap">
          <text class="loading-icon" wx:if="{{isLoadingMore}}">⟳</text>
          <text>{{isLoadingMore ? '加载中...' : loadingMoreText}}</text>
        </view>
        <view id="record-{{index}}" class="timeline-item timeline-{{item.eventClass}} {{item.isMe ? 'is-me' : ''}}" wx:for="{{room.records}}" wx:key="recordKey" bindtap="onRecordTap" data-record="{{item}}">
          <view class="timeline-marker">{{item.eventIcon}}</view>
          <image class="timeline-avatar" wx:if="{{!item.isSystem}}" src="{{item.detail.operatorAvatar || '/images/avatar.png'}}"></image>
          <view class="timeline-body">
            <view class="timeline-meta">
              <text class="timeline-operator">{{item.isSystem ? '房间动态' : item.detail.operator}}</text>
              <text class="timeline-time">{{item.time}}</text>
            </view>
            <text class="timeline-content">
              <block wx:if="{{item.segments}}"><text wx:for="{{item.segments}}" wx:for-item="segment" wx:key="index" class="{{segment.isMe ? 'me' : ''}} {{segment.isAmount ? 'transfer-amount' : ''}}">{{segment.text}}</text></block>
              <block wx:else>{{item.processedDescription || item.description}}</block>
            </text>
          </view>
        </view>
      </view>
    </scroll-view>
    <view class="bottom-actions-container scoreboard-bottom-action" wx:if="{{room.gameMode === 'normal'}}">
      <view class="action-btn expense-btn {{room.status !== 'playing' ? 'disabled' : ''}}" bindtap="handleExpenseBtn" hover-class="control-pressed">
        <text class="btn-text">批量支出</text>
      </view>
    </view>
    <view class="bottom-actions-container bet-bottom-actions" wx:if="{{room.gameMode === 'bet' && room.status === 'playing'}}">
      <view class="bottom-game-btn base-bet {{!room.baseBetValue || gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handleBaseBet" hover-class="control-pressed">底注</view>
      <view class="bottom-game-btn follow {{!canFollow || gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handleFollow" hover-class="control-pressed">跟注</view>
      <view class="bottom-game-btn allin {{myScore <= 0 || gameOperationSubmitting ? 'disabled' : ''}}" bindtap="handleAllIn" hover-class="control-pressed">All-in</view>
    </view>
  </view>

  <!-- 全屏悬浮拖动菜单 (Floating Action Button) - 放在最外层确保 iOS z-index 正确 -->
  <movable-area class="fab-area">
    <movable-view
      class="fab-container"
      direction="all"
      x="{{fabX}}"
      y="{{fabY}}"
      inertia
      friction="2"
      damping="20"
      out-of-bounds="{{false}}"
      bindchange="onFabChange"
      width="100"
      height="100">
      <!-- 子按钮菜单 -->
      <view class="fab-menu {{fabOnLeft ? 'expand-right' : 'expand-left'}} {{fabExpanded ? 'expanded' : ''}}">
        <!-- 设置按钮 -->
        <view class="fab-sub-btn settings" wx:if="{{isCreator}}" bindtap="openSettingsModal" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">设置</text>
        </view>
        <!-- 结算按钮 -->
        <view class="fab-sub-btn settle {{room.status !== 'playing' || settleSubmitting ? 'disabled' : ''}}" bindtap="handleSettleBtn" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">结算</text>
        </view>
        <!-- 解散按钮（仅房主可见） -->
        <view class="fab-sub-btn dismiss" wx:if="{{isCreator && room.status === 'playing'}}" bindtap="openDismissConfirm" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">解散</text>
        </view>
        <!-- 退出按钮 -->
        <view class="fab-sub-btn exit" bindtap="openExitConfirm" hover-class="fab-sub-pressed">
          <text class="fab-sub-label">退出</text>
        </view>
      </view>
      <!-- 主按钮 -->
      <view class="fab-main" bindtap="toggleFab" hover-class="control-pressed">
        <text class="fab-main-icon {{fabExpanded ? 'rotated' : ''}}">☰</text>
      </view>
    </movable-view>
  </movable-area>
</view>

<view class="float-animation-container" wx:if="{{showFloatAnimation}}">
  <text class="float-amount" style="left: {{floatLeft}}px; top: {{floatTop}}px;">+{{floatAmount}}</text>
</view>

<view class="receive-animation-container {{receiveAnimationRole}} phase-{{receiveAnimationPhase}}" wx:if="{{showReceiveAnimation}}">
  <view class="claim-orb" wx:if="{{claimMotionReady && receiveAnimationRole === 'full'}}" style="left: {{claimStartX}}px; top: {{claimStartY}}px; --claim-x: {{claimDeltaX}}px; --claim-y: {{claimDeltaY}}px;"></view>
  <view class="reward-focus">
    <view class="reward-particle particle-{{index}}" wx:for="{{confettiList}}" wx:key="id"></view>
    <view class="reward-token">
      <text class="reward-token__amount">+{{receiveAmount}}</text>
      <text class="reward-token__name">{{receivePlayerName}} 收取奖池</text>
    </view>
  </view>
</view>
<view class="modal-mask {{showExpenseModal ? 'show' : ''}}" wx:if="{{showExpenseModal}}" bindtap="closeExpenseModal"></view>
<view class="expense-modal {{showExpenseModal ? 'show' : ''}}" wx:if="{{showExpenseModal}}">
  <view class="modal-header">
    <text class="modal-title">批量支出</text>
    <text class="modal-close" bindtap="closeExpenseModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="expense-info">
      <view class="info-row">
        <text class="info-label">支出方:</text>
        <text class="info-value">{{currentUser}}</text>
      </view>
    </view>
    <view class="expense-list">
      <view class="expense-item" wx:for="{{room.members}}" wx:key="openid" wx:if="{{item.openid !== myOpenid && !item.isExited}}">
        <view class="player-info">
          <image class="player-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}"></image>
          <text class="player-name">{{item.name}}</text>
        </view>
        <view class="input-section">
          <input class="score-input" type="digit" maxlength="16" placeholder="0" value="{{expenseAmounts[item.openid] || ''}}" data-openid="{{item.openid}}" bindinput="onExpenseAmountInput" />
          <text class="score-unit">积分</text>
        </view>
      </view>
    </view>
    <view class="expense-total">
      <text class="total-label">总计支出:</text>
      <text class="total-value">{{expenseTotal || 0}} 积分</text>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeExpenseModal">取消</view>
      <view class="action-btn confirm {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmExpense">{{gameOperationSubmitting ? '支出中…' : '确认支出'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showTransferPicker ? 'show' : ''}}" wx:if="{{showTransferPicker}}" bindtap="closeTransferPicker"></view>
<view class="transfer-picker-modal {{showTransferPicker ? 'show' : ''}}" wx:if="{{showTransferPicker}}">
  <view class="modal-header"><text class="modal-title">选择接收玩家</text><text class="modal-close" bindtap="closeTransferPicker">✕</text></view>
  <scroll-view class="transfer-player-list" scroll-y>
    <view class="transfer-player-row" wx:for="{{room.members}}" wx:key="openid" wx:if="{{item.openid !== myOpenid && !item.isExited}}" data-openid="{{item.openid}}" bindtap="selectTransferTarget" hover-class="transfer-player-row--pressed">
      <image class="player-avatar" src="{{item.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image><text class="player-name">{{item.name}}</text><text class="player-current-score {{item.scoreScroll ? 'compact-number' : ''}}">{{item.score > 0 ? '+' : ''}}{{item.score}}</text><text class="history-arrow">›</text>
    </view>
  </scroll-view>
</view>
<view class="modal-mask {{showTransferModal ? 'show' : ''}}" wx:if="{{showTransferModal}}" bindtap="closeTransferModal"></view>
<view class="transfer-modal {{showTransferModal ? 'show' : ''}}" wx:if="{{showTransferModal}}">
  <view class="modal-header">
    <text class="modal-title">转分</text>
    <text class="modal-close" bindtap="closeTransferModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="transfer-info">
      <view class="info-row">
        <text class="info-label">转出方:</text>
        <text class="info-value">{{currentUser}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">接收方:</text>
        <text class="info-value">{{targetMember}}</text>
      </view>
    </view>
    <view class="input-section">
      <input class="score-input {{showInputError ? 'error' : ''}}" type="digit" maxlength="16" placeholder="请输入积分" value="{{transferAmount}}" bindinput="onTransferAmountInput" />
      <text class="error-tip" wx:if="{{showInputError}}">仅支持正整数积分</text>
    </view>
    <view class="modal-actions">
<view class="action-btn cancel {{transferSubmitting ? 'disabled' : ''}}" bindtap="{{transferSubmitting ? '' : 'closeTransferModal'}}">取消</view>
      <view class="action-btn confirm {{transferSubmitting ? 'disabled' : ''}}" bindtap="{{transferSubmitting ? '' : 'confirmTransfer'}}">
        {{transferSubmitting ? '中...' : '确认转入'}}
      </view>
    </view>
  </view>
</view>

<view class="modal-mask {{showPrizeModal ? 'show' : ''}}" wx:if="{{showPrizeModal}}" bindtap="closePrizeModal"></view>
<view class="prize-modal {{showPrizeModal ? 'show' : ''}}" wx:if="{{showPrizeModal}}">
  <view class="modal-header">
    <text class="modal-title">转入奖池</text>
    <text class="modal-close" bindtap="closePrizeModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="prize-input-info">
      <text class="info-label">操作玩家:</text>
      <text class="info-value">{{currentUser}}</text>
    </view>
    <view class="input-section">
      <input class="score-input {{showInputError ? 'error' : ''}}" type="digit" maxlength="16" placeholder="请输入积分" value="{{prizeAmount}}" bindinput="onPrizeAmountInput" />
      <text class="error-tip" wx:if="{{showInputError}}">仅支持正整数积分</text>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closePrizeModal">取消</view>
      <view class="action-btn confirm {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmPrizeTransfer">{{gameOperationSubmitting ? '转入中…' : '确认转入'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showReceiveModal ? 'show' : ''}}" wx:if="{{showReceiveModal}}" bindtap="closeReceiveModal"></view>
<view class="confirm-modal {{showReceiveModal ? 'show' : ''}}" wx:if="{{showReceiveModal}}">
  <view class="modal-header">
    <text class="modal-title">确认收取</text>
    <text class="modal-close" bindtap="closeReceiveModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认收取奖池全部【{{room.prizePool.total}}】积分？</view>
    <view class="confirm-sub">收取后奖池清空</view>
    <view class="modal-actions">
      <view class="action-btn cancel" bindtap="closeReceiveModal">取消</view>
      <view class="action-btn confirm {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmReceive">{{gameOperationSubmitting ? '收取中…' : '确认收取'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showTipModal ? 'show' : ''}}" wx:if="{{showTipModal}}"></view>
<view class="tip-modal {{showTipModal ? 'show' : ''}}" wx:if="{{showTipModal}}">
  <view class="tip-content">
    <text class="tip-text">{{tipText}}</text>
  </view>
</view>

<view class="modal-mask {{showSettleConfirm ? 'show' : ''}}" wx:if="{{showSettleConfirm}}" bindtap="closeSettleConfirm"></view>
<view class="confirm-modal {{showSettleConfirm ? 'show' : ''}}" wx:if="{{showSettleConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认结算</text>
    <text class="modal-close" bindtap="closeSettleConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认结束本局并生成战绩？</view>
    <view class="confirm-sub">结算后将不能继续记分</view>
    <view class="modal-actions">
      <view class="action-btn cancel {{settleSubmitting ? 'disabled' : ''}}" bindtap="closeSettleConfirm">取消</view>
      <view class="action-btn confirm {{settleSubmitting ? 'disabled' : ''}}" bindtap="confirmSettle">{{settleSubmitting ? '结算中…' : '确认结算'}}</view>
    </view>
  </view>
</view>

<history-detail
  visible="{{showResultModal}}"
  theme="{{appearanceTheme}}"
  detail="{{resultData}}"
  players="{{resultPlayers}}"
  bind:close="closeResultModal"
/>

<view class="all-in-tip {{showBaseBetTip ? 'show' : ''}}" wx:if="{{showBaseBetTip}}">
  <text class="tip-content-text">请先设置底注值</text>
</view>

<view class="modal-mask {{showAllInConfirm ? 'show' : ''}}" wx:if="{{showAllInConfirm}}" bindtap="closeAllInConfirm"></view>
<view class="confirm-modal {{showAllInConfirm ? 'show' : ''}}" wx:if="{{showAllInConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认 All-in</text>
    <text class="modal-close" bindtap="closeAllInConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">是否Allin所有分数</view>
    <view class="confirm-sub">确认后将把当前全部积分转入奖池</view>
    <view class="modal-actions">
      <view class="action-btn cancel {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="closeAllInConfirm">再想想</view>
      <view class="action-btn confirm allin-confirm-btn {{gameOperationSubmitting ? 'disabled' : ''}}" bindtap="confirmAllIn">{{gameOperationSubmitting ? '转入中…' : '确认'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showExitConfirm ? 'show' : ''}}" wx:if="{{showExitConfirm}}" bindtap="closeExitConfirm"></view>
<view class="confirm-modal {{showExitConfirm ? 'show' : ''}}" wx:if="{{showExitConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认退出</text>
    <text class="modal-close" bindtap="closeExitConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认退出本房间？</view>
    <view class="confirm-sub">退出后将显示为离线，当前积分会保留并参与结算；重新扫码可回到房间</view>
    <view class="modal-actions">
      <view class="action-btn cancel {{exitSubmitting ? 'disabled' : ''}}" bindtap="closeExitConfirm">取消</view>
      <view class="action-btn confirm {{exitSubmitting ? 'disabled' : ''}}" bindtap="confirmExit">{{exitSubmitting ? '退出中…' : '确认退出'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showDismissConfirm ? 'show' : ''}}" wx:if="{{showDismissConfirm}}" bindtap="closeDismissConfirm"></view>
<view class="confirm-modal {{showDismissConfirm ? 'show' : ''}}" wx:if="{{showDismissConfirm}}">
  <view class="modal-header">
    <text class="modal-title">确认解散</text>
    <text class="modal-close" bindtap="closeDismissConfirm">✕</text>
  </view>
  <view class="modal-body">
    <view class="confirm-text">确认解散本房间？</view>
    <view class="confirm-sub">房间将直接删除，不结算、也不生成战绩</view>
    <view class="modal-actions">
      <view class="action-btn cancel {{dismissSubmitting ? 'disabled' : ''}}" bindtap="closeDismissConfirm">取消</view>
      <view class="action-btn confirm dismiss-confirm-btn {{dismissSubmitting ? 'disabled' : ''}}" bindtap="confirmDismiss">{{dismissSubmitting ? '解散中…' : '确认解散'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showSettingsModal ? 'show' : ''}}" wx:if="{{showSettingsModal}}" bindtap="closeSettingsModal"></view>
<view class="settings-modal {{showSettingsModal ? 'show' : ''}}" wx:if="{{showSettingsModal}}">
  <view class="modal-header">
    <text class="modal-title">房间设置</text>
    <text class="modal-close" bindtap="closeSettingsModal">✕</text>
  </view>
  <view class="modal-body">
    <view class="setting-item" wx:if="{{room.gameMode === 'bet'}}">
      <view class="setting-label">底注值设置</view>
      <view class="setting-description">设置每次点击底注固定转入的积分（仅房主可设置）</view>
      <view class="setting-input-wrapper">
        <input class="setting-input" type="digit" maxlength="16" placeholder="请输入" value="{{baseBetInput}}" bindinput="onBaseBetInput" />
        <text class="setting-unit">分</text>
      </view>
    </view>
    <view class="modal-actions">
      <view class="action-btn cancel {{settingsSubmitting ? 'disabled' : ''}}" bindtap="closeSettingsModal">取消</view>
      <view class="action-btn confirm {{settingsSubmitting ? 'disabled' : ''}}" bindtap="saveSettings">{{settingsSubmitting ? '保存中…' : '确认保存'}}</view>
    </view>
  </view>
</view>

<view class="modal-mask {{showQrcode ? 'show' : ''}}" wx:if="{{showQrcode}}" bindtap="hideQrcode"></view>
<view class="qrcode-modal {{showQrcode ? 'show' : ''}}" wx:if="{{showQrcode}}">
  <view class="qrcode-header">
    <text class="qrcode-title">邀请好友</text>
    <text class="qrcode-close" bindtap="hideQrcode">✕</text>
  </view>
  <view class="qrcode-body">
    <view class="room-info-card">
      <text class="info-name">{{room.roomName}}</text>
      <text class="info-id">房间号: {{room._id}}</text>
    </view>
    
    <!-- 小程序码图片 -->
    <view class="qrcode-image-wrapper">
      <image 
        class="qrcode-image" 
        src="{{qrCodeTempUrl}}"
        mode="aspectFit"
        wx:if="{{qrCodeFileID && !qrCodeError}}"
      ></image>
      
      <!-- 生成中状态 -->
      <view class="qrcode-loading" wx:if="{{isGeneratingQR && !qrCodeFileID}}">
        <text class="loading-text">二维码生成中...</text>
      </view>
      
      <!-- 生成失败状态 -->
      <view class="qrcode-error" wx:if="{{qrCodeError}}" bindtap="getRoomQRCode">
        <text class="error-text">二维码生成失败</text>
        <text class="retry-text">点击重试</text>
      </view>
    </view>
    
    <text class="qrcode-tip" wx:if="{{!qrCodeError}}">微信扫码即可加入房间</text>
    
    <view class="qrcode-actions">
      <view class="action-btn confirm {{!qrCodeFileID || qrCodeError || qrCodeSaving ? 'disabled' : ''}}" bindtap="{{qrCodeFileID && !qrCodeError && !qrCodeSaving ? 'saveQrcode' : ''}}"><text>{{qrCodeSaving ? '保存中…' : '保存图片'}}</text></view>
      <button class="action-btn secondary share-btn" open-type="share"><text>分享给好友</text></button>
    </view>
  </view>
</view>

<!-- 编辑用户信息弹窗 -->
<view class="modal-mask {{showEditProfileModal ? 'show' : ''}}" wx:if="{{showEditProfileModal}}" bindtap="closeEditProfileModal"></view>
<view class="edit-profile-modal {{showEditProfileModal ? 'show' : ''}}" wx:if="{{showEditProfileModal}}">
  <view class="edit-profile-header">
    <text class="edit-profile-title">编辑资料</text>
    <text class="edit-profile-close" bindtap="closeEditProfileModal">✕</text>
  </view>
  <view class="edit-profile-body">
    <!-- 头像编辑 -->
    <view class="avatar-edit-section">
      <button class="avatar-edit-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <view class="edit-avatar-wrapper">
          <image class="edit-avatar-img" src="{{editProfile.avatarUrl || '/images/avatar.png'}}" mode="aspectFill"></image>
          <view class="avatar-edit-icon">
            <text class="edit-icon-text">✏️</text>
          </view>
        </view>
      </button>
    </view>
    
    <!-- 昵称编辑 -->
    <view class="nickname-edit-section">
      <text class="edit-label">昵称</text>
      <input 
        class="nickname-input" 
        type="nickname" 
        maxlength="10"
        placeholder="请输入昵称" 
        value="{{editProfile.nickname}}"
        bindinput="onNicknameInput"
        bindblur="onNicknameConfirm"
      />
    </view>
    
    <!-- 保存按钮 -->
    <view class="edit-profile-actions">
      <view class="action-btn save-profile-btn {{isSavingProfile ? 'disabled' : ''}}" bindtap="{{isSavingProfile ? '' : 'saveProfile'}}">
        <text class="save-btn-text">{{isSavingProfile ? '保存中...' : '保存'}}</text>
      </view>
    </view>
  </view>
</view>
</view><!-- /room-page -->

<!-- 分享回调必须同步返回图片，因此在房间载入后用屏幕外 Canvas 预生成封面。 -->
<canvas type="2d" id="shareCardCanvas" class="share-card-canvas"></canvas>
