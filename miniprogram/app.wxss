/* 全局视觉基础：轻量、克制的 iOS 分组界面语言 */
page {
  --app-background: #F6FAFB;
  min-height: 100%;
  background: var(--app-background);
  color: #1c1c1e;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  -webkit-font-smoothing: antialiased;
}

button, input, textarea { font-family: inherit; }
button::after { border: 0; }
.pressable { transition: transform 160ms cubic-bezier(.22,.8,.25,1), opacity 160ms ease; }
.pressable:active { opacity: .72; transform: scale(.98); }

/* GSAP skill motion language, implemented with Mini Program native transforms. */
.motion-full {
  --motion-fast: 140ms;
  --motion-base: 240ms;
  --motion-slow: 420ms;
  --motion-ease-out: cubic-bezier(.16,1,.3,1);
  --motion-ease-standard: cubic-bezier(.22,.8,.25,1);
}

.motion-reduced {
  --motion-fast: 80ms;
  --motion-base: 120ms;
  --motion-slow: 160ms;
  --motion-ease-out: ease-out;
  --motion-ease-standard: ease-out;
}

.control-pressed { opacity: .74; transform: scale(.97); }
.card-pressed { opacity: .82; transform: translate3d(0,2rpx,0) scale(.985); }

@media (prefers-reduced-motion: reduce) {
  .motion-full { --motion-fast: 1ms; --motion-base: 1ms; --motion-slow: 1ms; }
}

.theme-light {
  --page-bg: var(--app-background); --page-top: var(--app-background); --surface: #ffffff;
  --surface-raised: rgba(255,255,255,.78); --surface-secondary: #f7f7fa;
  --text-primary: #1c1c1e; --text-secondary: #6e6e73; --text-tertiary: #8e8e93;
  --separator: rgba(60,60,67,.075); --accent: #28a860; --accent-soft: #eef9f2;
  --danger: #ff3b30; --positive: #248d52; --negative: #d64545;
  --glass: rgba(255,255,255,.68); --mask: rgba(0,0,0,.28); --shadow: rgba(28,28,30,.07);
}

.theme-dark {
  --page-bg: #0f1210; --page-top: #111513; --surface: #1c201e;
  --surface-raised: rgba(31,36,33,.78); --surface-secondary: #171a18;
  --text-primary: #f4f5f4; --text-secondary: #c1c5c2; --text-tertiary: #8e938f;
  --separator: rgba(235,235,245,.085); --accent: #48d17b; --accent-soft: rgba(72,209,123,.12);
  --danger: #ff6961; --positive: #57d985; --negative: #ff716b;
  --glass: rgba(27,32,29,.68); --mask: rgba(0,0,0,.52); --shadow: rgba(0,0,0,.26);
}
