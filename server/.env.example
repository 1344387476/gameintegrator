# 复制到 server/.env；示例占位值必须替换，不能提交真实密钥。
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=gameintegrator_dev
PGUSER=gameintegrator_dev
PGPASSWORD=replace-with-a-random-database-password
PGPOOL_MAX=5
# disable 仅用于本机/隔离容器网络；跨主机连接使用 verify-full。
PGSSLMODE=disable

WECHAT_APP_ID=wx7687ea673d95f908
WECHAT_APP_SECRET=replace-with-wechat-app-secret
WECHAT_TIMEOUT_MS=5000
SESSION_TTL_SECONDS=604800
# 默认不信任转发头。只有确认API不能绕过可信反向代理访问后，才允许设为1。
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT_MAX=10
# 单实例WSS连接上限和服务端ping间隔；超过上限时客户端回退REST校正。
WEBSOCKET_MAX_CONNECTIONS=200
WEBSOCKET_HEARTBEAT_MS=30000
# 默认头像目录为 server/data/avatars（与启动命令所在目录无关）。
# 如需覆盖，使用专用目录的绝对路径；容器必须挂载持久化卷。
# AVATAR_STORAGE_DIR=/srv/gameintegrator/avatars
